{
  "name": "the-wan-standard-shop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm test",
    "build": "next build && npm run build:functions",
    "build:functions": "npx --yes wrangler@4.100.0 pages functions build functions --outdir out/_worker.js --project-directory . --build-output-directory out --compatibility-date 2024-12-30 --minify",
    "postbuild": "npm run scan:retired-origins && npm run scan:pages-worker",
    "start": "next start",
    "lint": "eslint",
    "test": "NEXT_PUBLIC_API_BASE_URL=https://bakuure.api.n1.tachy.one/ playwright test tests/storekit-api-origin.spec.ts tests/retired-origin-artifact-scan.spec.ts tests/commerce-resilience.spec.ts tests/storekit-sdk-migration.spec.ts",
    "scan:retired-origins": "node scripts/check-retired-origins.mjs out",
    "scan:pages-worker": "node scripts/check-pages-worker.mjs out/_worker.js/index.js"
  },
  "dependencies": {
    "@tachyon-sdk/storekit": "0.3.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
